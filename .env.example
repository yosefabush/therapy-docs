# ---------------------------------------------------------------------------
# TherapyDocs environment configuration
#
# Copy this file to `.env.local` for local development and provide real values.
# In production these MUST be set (the app refuses insecure defaults when
# NODE_ENV=production) and should come from a managed secret store
# (AWS Secrets Manager / KMS, Azure Key Vault, HashiCorp Vault, etc.).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Secret used to derive the AES-256-GCM key for encrypting PHI at rest.
# Use a long, random value (e.g. `openssl rand -base64 48`).
ENCRYPTION_KEY=

# Secret for signing/verifying session JWTs (jose, HS256).
# Use a long, random value (e.g. `openssl rand -base64 48`).
JWT_SECRET=

# Secret for keyed, deterministic search hashing (HMAC-SHA256).
SEARCH_HASH_KEY=

# Deepgram API key for server-side audio transcription.
# Obtain from https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Optional: set to "true" to enable verbose debug logging in any environment.
# DEBUG_LOGGING=false
